<?xml version="1.0" encoding="UTF-8"?>
<plugin version="1">
  <name>ChartGrabber</name>
  <version>@PROJECT_VERSION@</version>
  <release>1</release>
  <summary>Download charts for use offline</summary>
  <api-version>1.18</api-version>
  <open-source>yes</open-source>
  <author>@CG_AUTHOR@</author>
  <source>local build</source>
  <info-url></info-url>
  <description>Pick an area on the chart, a chart source and the detail; Chart Grabber downloads it with Chart Grabber CLI and adds it to OpenCPN as a chart that works without internet.</description>
  <target>@CG_TARGET@</target>
  <target-version>@CG_TARGET_VERSION@</target-version>
  <target-arch>@CG_TARGET_ARCH@</target-arch>
</plugin>
